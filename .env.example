NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Or use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
GROQ_API_KEY=your-groq-api-key
# Optional: OpenRouter-compatible credentials for model routing.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=google/gemma-4-31b-it:free
# Optional local OmniRoute/OpenAI-compatible gateway. When set, cloud fallback
# uses this endpoint and model before the direct OpenRouter endpoint.
# AI_GATEWAY_BASE_URL=http://127.0.0.1:20128/v1
# AI_GATEWAY_API_KEY=your-gateway-api-key
# AI_GATEWAY_MODEL=auto
# Optional: alternative document-analysis backend (lib/home-office/cerebras-provider.ts).
# Leave unset to keep Groq as the only provider.
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=qwen-3.8-27b
# Provider routing: local Ollama first; cloud is used only after local failure/timeout.
# Keep false when customer documents must remain local.
AI_ALLOW_CLOUD_FALLBACK=false
AUTOMATION_WEBHOOK_URL=https://your-activepieces.example/webhook/horizon-offer-request
AUTOMATION_WEBHOOK_SECRET=your-webhook-secret

# Affiliate operator callback (server-side only). The automation/orchestrator
# calls POST /api/affiliate/callback with this value in X-Horizon-Operator-Secret
# to advance a stored request's status. Minimum 16 characters. Without it the
# endpoint stays disabled (503) so it can never be called anonymously.
AFFILIATE_OPERATOR_SECRET=

# HORIZON P11 — outbound SMTP (server-side only; never expose with NEXT_PUBLIC_).
# All five are required together. If any is missing or invalid, the send engine
# reports PROVIDER_UNAVAILABLE and transmits nothing.
HORIZON_SMTP_HOST=smtp.your-provider.example
# 587 uses STARTTLS; 465 uses implicit TLS. Default is derived from the port.
HORIZON_SMTP_PORT=587
# Optional: set only if your server does not use the port-based default.
# HORIZON_SMTP_SECURE=false
HORIZON_SMTP_USER=mailer@your-domain.example
HORIZON_SMTP_PASSWORD=your-smtp-password
# Envelope sender. Must be an address your SMTP server is authorised to use.
HORIZON_SMTP_FROM=no-reply@your-domain.example
# Optional: HELO/EHLO name and Message-ID domain.
# HORIZON_SMTP_HELO_NAME=mail.your-domain.example

# Optional: connect a user's own Gmail account for outbound messages.
# Keep the client secret and encryption key server-side only.
HORIZON_GOOGLE_CLIENT_ID=your-google-oauth-client-id
HORIZON_GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
HORIZON_GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
HORIZON_EMAIL_TOKEN_ENCRYPTION_KEY=your-32-byte-base64-key
