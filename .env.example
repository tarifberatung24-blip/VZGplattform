NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-public-anon-key
# Or use NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-public-publishable-key
SUPABASE_SECRET_KEY=your-server-only-secret-key
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=http://localhost:3000/auth/callback
GROQ_API_KEY=your-groq-api-key
# Optional: OpenRouter-compatible credentials for model routing.
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=anthropic/claude-sonnet-5
# Optional: alternative document-analysis backend (lib/home-office/cerebras-provider.ts).
# Leave unset to keep Groq as the only provider.
CEREBRAS_API_KEY=your-cerebras-api-key
CEREBRAS_MODEL=qwen-3.8-27b
N8N_OFFER_REQUEST_WEBHOOK_URL=https://your-n8n.example/webhook/offer-request
N8N_WEBHOOK_SECRET=your-webhook-secret
# HORIZON NEGOTIATE — MODE B assisted negotiation (all optional; the feature is off
# unless HORIZON_NEGOTIATION_ENABLED is truthy). The transport is provider-neutral:
# the same variables point at Activepieces Cloud, n8n, Windmill or any webhook
# orchestrator, and swapping the receiver does not touch business logic.
#   * HORIZON_AUTOMATION_NEGOTIATION_WEBHOOK_URL — outbound endpoint (https only;
#     http is accepted for localhost during local development).
#   * HORIZON_AUTOMATION_WEBHOOK_SECRET — shared secret sent on the outbound POST.
#   * HORIZON_AUTOMATION_CALLBACK_SECRET — shared secret the receiver must present
#     when it calls the status callback back into HORIZON. Kept separate from the
#     outbound secret so knowing one does not grant the other.
# Both secrets must be long random values and are never exposed to the browser.
# Configuration is resolved pairwise: if either HORIZON_AUTOMATION_* variable is
# set, BOTH must be set, and the legacy pair is never borrowed to fill a gap. Only
# when neither neutral variable is set are the legacy N8N_NEGOTIATION_ASSISTED_
# WEBHOOK_URL / N8N_WEBHOOK_SECRET names read, and then both are required. A
# half-migrated pair therefore disables the handoff (503) instead of silently
# sending one receiver's secret to another.
# HORIZON_NEGOTIATION_ENABLED=false
# HORIZON_AUTOMATION_NEGOTIATION_WEBHOOK_URL=https://cloud.activepieces.com/api/v1/webhooks/your-flow-id
# HORIZON_AUTOMATION_WEBHOOK_SECRET=your-long-random-webhook-secret
# HORIZON_AUTOMATION_CALLBACK_SECRET=your-long-random-callback-secret

# HORIZON P11 — outbound SMTP (server-side only; never expose with NEXT_PUBLIC_).
# All five are required together. If any is missing or invalid, the send engine
# reports PROVIDER_UNAVAILABLE and transmits nothing.
HORIZON_SMTP_HOST=smtp.your-provider.example
# 587 uses STARTTLS; 465 uses implicit TLS. Default is derived from the port.
HORIZON_SMTP_PORT=587
# Optional: set only if your server does not use the port-based default.
# HORIZON_SMTP_SECURE=false
HORIZON_SMTP_USER=mailer@your-domain.example
HORIZON_SMTP_PASSWORD=your-smtp-password
# Envelope sender. Must be an address your SMTP server is authorised to use.
HORIZON_SMTP_FROM=no-reply@your-domain.example
# Optional: HELO/EHLO name and Message-ID domain.
# HORIZON_SMTP_HELO_NAME=mail.your-domain.example
